# Configurazione LiteLLM (o proxy generico)
LLM_API_BASE=http://host.docker.internal:4000
LLM_API_KEY=la-tua-chiave-segreta

OPENCODE_VERSION=latest

# Modelli disponibili
AVAILABLE_MODELS=gemini/gemini-4-argon

# Modello di default
MODEL=gemini/gemini-4-argon

# Endpoint Ollama sull'host (opzionale, default: http://host.docker.internal:11434/v1)
OLLAMA_API_BASE=http://host.docker.internal:11434/v1
